{
  "version": 1,
  "author": "Mahather11",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-stm32-bluepill",
      "id": "bluepill",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -120,
      "left": 160,
      "attrs": {}
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 30,
      "left": 160,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir1",
      "top": 180,
      "left": 160,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -120,
      "left": -180,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-ky-040",
      "id": "encoder1",
      "top": 30,
      "left": -180,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer1",
      "top": 180,
      "left": -180,
      "attrs": {}
    }
  ],
  "connections": [
    [ "$serialMonitor:TX", "bluepill:A10", "", [] ],
    [ "$serialMonitor:RX", "bluepill:A9", "", [] ],

    [ "dht1:VCC", "bluepill:3V3.1", "red", [ "v0" ] ],
    [ "dht1:GND", "bluepill:GND.1", "black", [ "v0" ] ],
    [ "dht1:SDA", "bluepill:A1", "green", [ "v0" ] ],

    [ "ldr1:VCC", "bluepill:3V3.1", "red", [ "v0" ] ],
    [ "ldr1:GND", "bluepill:GND.1", "black", [ "v0" ] ],
    [ "ldr1:AO", "bluepill:A0", "orange", [ "v0" ] ],

    [ "pir1:VCC", "bluepill:3V3.1", "red", [ "v0" ] ],
    [ "pir1:GND", "bluepill:GND.1", "black", [ "v0" ] ],
    [ "pir1:OUT", "bluepill:A2", "purple", [ "v0" ] ],

    [ "oled1:GND", "bluepill:GND.1", "black", [ "v0" ] ],
    [ "oled1:VCC", "bluepill:3V3.1", "red", [ "v0" ] ],
    [ "oled1:SCL", "bluepill:B6", "green", [ "v0" ] ],
    [ "oled1:SDA", "bluepill:B7", "green", [ "v0" ] ],

    [ "encoder1:VCC", "bluepill:3V3.1", "red", [ "v0" ] ],
    [ "encoder1:GND", "bluepill:GND.1", "black", [ "v0" ] ],
    [ "encoder1:CLK", "bluepill:A3", "green", [ "v0" ] ],
    [ "encoder1:DT", "bluepill:A4", "green", [ "v0" ] ],
    [ "encoder1:SW", "bluepill:A5", "green", [ "v0" ] ],

    [ "buzzer1:1", "bluepill:GND.1", "black", [ "v0" ] ],
    [ "buzzer1:2", "bluepill:A8", "red", [ "v0" ] ]
  ]
